// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Question {
  id               Int      @id @default(autoincrement())
  question         String
  belongs_to_quiz  Quiz     @relation(fields: [belongs_to_quiz_id], references: [id])
  belongs_to_quiz_id Int 
}

model Quiz {
  id           Int      @id @default(autoincrement())
  name         String
  description  String
  questions    Question[]
}
